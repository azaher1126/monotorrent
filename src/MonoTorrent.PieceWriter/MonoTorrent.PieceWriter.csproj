<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Shared internal utilities centralized in core (ProjectRef + IVT). Use*=false to avoid dups like CS0433 for EnsureThreadPool, SpinLocked etc. -->
    <UseEnsureThreadPool>false</UseEnsureThreadPool>
    <UseIListExtensions>false</UseIListExtensions>
    <UseSemaphoreSlimExtensions>true</UseSemaphoreSlimExtensions>
    <UseSimpleSpinLock>false</UseSimpleSpinLock>
    <UseThreadSwitcher>false</UseThreadSwitcher>
    <UseTorrentFileExtensions>false</UseTorrentFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitInfo" />
    <PackageReference Include="ReusableTasks" />
    <ProjectReference Include="..\MonoTorrent\MonoTorrent.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>
