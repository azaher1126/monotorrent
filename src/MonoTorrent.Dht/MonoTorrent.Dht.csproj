<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <UseBigEndianBigInteger>true</UseBigEndianBigInteger>
    <UseCache>true</UseCache>
    <UseEnsureThreadPool>true</UseEnsureThreadPool>
    <UseMainLoop>true</UseMainLoop>
    <!-- SpinLocked centralized in the core MonoTorrent library (via ProjectReference + InternalsVisibleTo).
         Do not enable UseSimpleSpinLock here to avoid duplicate type definition when tests reference multiple assemblies. -->
    <UseSimpleSpinLock>false</UseSimpleSpinLock>
    <UseThreadSwitcher>true</UseThreadSwitcher>
    <UseValueStopWatch>true</UseValueStopWatch>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitInfo" />
    <PackageReference Include="ReusableTasks" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MonoTorrent.Messages\MonoTorrent.Messages.csproj" />
    <ProjectReference Include="..\MonoTorrent\MonoTorrent.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>
